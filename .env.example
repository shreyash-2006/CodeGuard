# example .env file — NO real secrets go here
# Copy to .env and fill in if needed (CodeGuard itself needs no secrets)

# Path to the dev sample JSONL (for model training at startup)
CODEGUARD_DEV_PATH=codeguard_dev.jsonl

# Uvicorn host/port (use with: uvicorn codeguard.app:app ...)
# HOST=0.0.0.0
# PORT=8000
